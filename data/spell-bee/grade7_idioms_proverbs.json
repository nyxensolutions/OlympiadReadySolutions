[{"questionText":"Which is the CORRECT spelling of the word in the idiom meaning to overcome a challenge?","options":["A) hurdle","B) hurdul","C) hurrdle","D) hurdle"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Hurdle is correct - H-U-R-D-L-E. To clear a hurdle means to overcome an obstacle or challenge."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to have something up your sleeve?","options":["A) sleeve","B) sleave","C") sleave","D) sieve"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Sleeve is correct - S-L-E-E-V-E. To have something up your sleeve means to have a secret plan or advantage."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb the pen is mightier than the sword?","options":["A) mightier","B) mightyer","C) mightyier","D) mightear"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Mightier is correct - M-I-G-H-T-I-E-R. In this proverb mightier is the comparative of mighty meaning more powerful."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to drag your feet?","options":["A) procrastinate","B") procrastanate","C) prokrastinate","D) procrastinnate"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Procrastinate is correct - P-R-O-C-R-A-S-T-I-N-A-T-E. To drag your feet means to procrastinate or delay unnecessarily."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to be on the fence?","options":["A) indecisive","B) indecesive","C") indecissive","D) indesicive"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Indecisive is correct - I-N-D-E-C-I-S-I-V-E. To be on the fence means to be indecisive about an issue."},{"questionText":"Which is the CORRECT spelling of the word in the proverb actions speak louder than words?","options":["A) actions","B) actioins","C) acttions","D) actionns"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Actions is correct - A-C-T-I-O-N-S. The proverb means that what people do is more important than what they say."},{"questionText":"Which is the CORRECT spelling of the word in the idiom meaning determined and not giving up?","options":["A) tenacious","B) tenacious","C") tenacuios","D) tennaciuos"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Tenacious is correct - T-E-N-A-C-I-O-U-S. To be tenacious means to hold firmly to something. Related to the idiom to hold your ground."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb necessity is the mother of invention?","options":["A) necessity","B) nessecity","C) neccesity","D) necessety"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Necessity is correct - N-E-C-E-S-S-I-T-Y. The proverb means that when you really need something you find a way to get it."},{"questionText":"Which is the CORRECT spelling of the word in the idiom burning the candle at both ends?","options":["A) exhaustion","B) exhasttion","C) exhaustoin","D) exhaustshun"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Exhaustion is correct - E-X-H-A-U-S-T-I-O-N. Burning the candle at both ends means working too hard and risking exhaustion."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb a stitch in time saves nine?","options":["A) prevention","B") prevension","C) prevenshun","D) preventtion"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Prevention is correct - P-R-E-V-E-N-T-I-O-N. A stitch in time saves nine means that prevention is better than cure."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to bite the bullet?","options":["A) endure","B") endur","C) endure","D) enduire"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Endure is correct - E-N-D-U-R-E. To bite the bullet means to endure a painful or difficult situation."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb let sleeping dogs lie?","options":["A) interference","B) interferance","C") interferrence","D) intaference"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Interference is correct - I-N-T-E-R-F-E-R-E-N-C-E. Let sleeping dogs lie means to avoid unnecessary interference in past matters."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to think outside the box?","options":["A) unconventional","B) unconventionall","C) unconvenshunall","D) unkonventional"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Unconventional is correct - U-N-C-O-N-V-E-N-T-I-O-N-A-L. To think outside the box means to think in an unconventional way."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom the ball is in your court?","options":["A) responsibility","B) responsibilety","C) responsibilty","D) responsibillity"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Responsibility is correct - R-E-S-P-O-N-S-I-B-I-L-I-T-Y. The ball is in your court means the responsibility for the next action is yours."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb the early bird catches the worm?","options":["A) diligence","B) dilligence","C") dilegence","D) dilgence"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Diligence is correct - D-I-L-I-G-E-N-C-E. The early bird catches the worm means that hard work and diligence bring reward."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to sit on the fence?","options":["A) neutrality","B) neutralety","C) nutrality","D) neutrallity"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Neutrality is correct - N-E-U-T-R-A-L-I-T-Y. To sit on the fence implies neutrality or refusal to take sides."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to go against the grain?","options":["A) convention","B") convenshun","C) conventioin","D) conventiion"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Convention is correct - C-O-N-V-E-N-T-I-O-N. To go against the grain means to act contrary to convention or accepted norms."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb all that glitters is not gold?","options":["A) deceptive","B) deceptiff","C") deceptive","D) decepteve"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Deceptive is correct - D-E-C-E-P-T-I-V-E. All that glitters is not gold means appearances can be deceptive."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to cut corners?","options":["A) negligent","B") negligant","C) neglegent","D) negliggent"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Negligent is correct - N-E-G-L-I-G-E-N-T. To cut corners means to be negligent and take shortcuts ignoring proper procedures."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to break new ground?","options":["A) innovation","B) innovasion","C") innovatoin","D) innnovation"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Innovation is correct - I-N-N-O-V-A-T-I-O-N. Double N. To break new ground means to introduce innovation or do something for the first time."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb charity begins at home?","options":["A) philanthropy","B) philantropy","C") phillanthropy","D) phiantropy"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Philanthropy is correct - P-H-I-L-A-N-T-H-R-O-P-Y. Charity begins at home relates to philanthropy starting within one community."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to have a chip on your shoulder?","options":["A) resentment","B") resentement","C) ressentment","D) resentmant"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Resentment is correct - R-E-S-E-N-T-M-E-N-T. To have a chip on your shoulder means to have deep-seated resentment."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to grasp at straws?","options":["A) desperation","B) desperasion","C") desperration","D) desperrashun"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Desperation is correct - D-E-S-P-E-R-A-T-I-O-N. To grasp at straws means to try anything out of desperation."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb every cloud has a silver lining?","options":["A) optimism","B) optimmism","C") optemism","D) optimisim"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Optimism is correct - O-P-T-I-M-I-S-M. Every cloud has a silver lining means there is always cause for optimism."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to weather the storm?","options":["A) perseverance","B") perseverence","C) perseverrance","D) persevearance"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Perseverance is correct - P-E-R-S-E-V-E-R-A-N-C-E. To weather the storm means to endure a difficult situation with perseverance."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to throw in the towel?","options":["A) surrender","B) surrrrender","C") surender","D) surrendar"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Surrender is correct - S-U-R-R-E-N-D-E-R. To throw in the towel means to surrender or admit defeat."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb fortune favours the brave?","options":["A) courageous","B") couragious","C) courageus","D) courrageous"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Courageous is correct - C-O-U-R-A-G-E-O-U-S. Fortune favours the brave means success comes to the courageous."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to bite off more than you can chew?","options":["A) overcommit","B") overcommitt","C) overcommit","D) ovvercommit"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Overcommit is correct - O-V-E-R-C-O-M-M-I-T. To bite off more than you can chew means to overcommit to more than one can handle."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb look before you leap?","options":["A) deliberate","B") deliberate","C) deliberait","D) delliberate"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Deliberate is correct - D-E-L-I-B-E-R-A-T-E. Look before you leap means to think or deliberate carefully before acting."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to kill two birds with one stone?","options":["A) efficiency","B") efficiancy","C) efficieny","D) efficciency"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Efficiency is correct - E-F-F-I-C-I-E-N-C-Y. To kill two birds with one stone means to achieve two goals with efficiency."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to play devil advocate?","options":["A) counterargument","B) counterargumment","C") counterrargument","D) counteargument"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Counterargument is correct - C-O-U-N-T-E-R-A-R-G-U-M-E-N-T. To play devil advocate means to present a counterargument to test an idea."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to add fuel to the fire?","options":["A) exacerbate","B) exaserbate","C") exacerrbate","D) exacerbate"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Exacerbate is correct - E-X-A-C-E-R-B-A-T-E. To add fuel to the fire means to exacerbate or worsen an already bad situation."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb honesty is the best policy?","options":["A) integrity","B) integrety","C") integreity","D) integity"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Integrity is correct - I-N-T-E-G-R-I-T-Y. Honesty is the best policy relates to the value of integrity in life."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to read between the lines?","options":["A) implication","B) implicasion","C") implecation","D) implicatoin"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Implication is correct - I-M-P-L-I-C-A-T-I-O-N. To read between the lines means to understand the implication or hidden meaning."},{"questionText":"Which is the CORRECT spelling of the word in the idiom to bury the hatchet?","options":["A) reconciliation","B") reconcileation","C) reconsiliation","D) reconcilliaton"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Reconciliation is correct - R-E-C-O-N-C-I-L-I-A-T-I-O-N. To bury the hatchet means to achieve reconciliation after a disagreement."},{"questionText":"Which is the CORRECT spelling of the word in the proverb the squeaky wheel gets the grease?","options":["A) persistence","B) persistance","C") persistince","D) persisttence"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Persistence is correct - P-E-R-S-I-S-T-E-N-C-E. The squeaky wheel gets the grease means persistence gets results."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to leave no stone unturned?","options":["A) thoroughness","B") thorooughness","C) thorroughness","D) thoroughnes"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Thoroughness is correct - T-H-O-R-O-U-G-H-N-E-S-S. To leave no stone unturned means to show thoroughness in finding a solution."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb two wrongs do not make a right?","options":["A) retaliation","B") retaliasion","C) retalation","D) retaliation"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Retaliation is correct - R-E-T-A-L-I-A-T-I-O-N. Two wrongs do not make a right means retaliation is never justified."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to cast a shadow?","options":["A) overshadow","B") overshaddow","C) overshadow","D) overshaddow"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Overshadow is correct - O-V-E-R-S-H-A-D-O-W. To cast a shadow or overshadow means to make something seem less important."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb birds of a feather flock together?","options":["A) camaraderie","B") camararderie","C) camaraderie","D) camearderie"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Camaraderie is correct - C-A-M-A-R-A-D-E-R-I-E. Birds of a feather flock together relates to the camaraderie of those who share interests."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to face the music?","options":["A) consequence","B") consequense","C) consequance","D) conseguence"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Consequence is correct - C-O-N-S-E-Q-U-E-N-C-E. To face the music means to accept the consequence of your actions."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb do unto others as you would have them do unto you?","options":["A) empathy","B") emmpathy","C) empethay","D) empathey"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Empathy is correct - E-M-P-A-T-H-Y. The golden rule proverb embodies the concept of empathy toward others."},{"questionText":"Which is the CORRECT spelling of the word in the idiom to cross the Rubicon?","options":["A) irreversible","B") irriverssible","C) irreversable","D) irriversible"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Irreversible is correct - I-R-R-E-V-E-R-S-I-B-L-E. To cross the Rubicon means to make an irreversible decision."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to turn over a new leaf?","options":["A) reformation","B") reformasion","C) reformaation","D) reformaiton"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Reformation is correct - R-E-F-O-R-M-A-T-I-O-N. To turn over a new leaf means to reform behaviour and start fresh."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb a penny saved is a penny earned?","options":["A) frugality","B") frugalety","C) frugalety","D) frugallity"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Frugality is correct - F-R-U-G-A-L-I-T-Y. A penny saved is a penny earned promotes the virtue of frugality."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to burn bridges?","options":["A) alienate","B") alieenate","C) alienatte","D) allienate"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Alienate is correct - A-L-I-E-N-A-T-E. To burn bridges means to permanently alienate people or destroy relationships."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb practice makes perfect?","options":["A) perseverance","B") perseverance","C) perseverence","D) persevearance"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Perseverance is correct - P-E-R-S-E-V-E-R-A-N-C-E. Practice makes perfect promotes perseverance and continued effort."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom the tip of the iceberg?","options":["A) underlying","B") underliyng","C) underllyng","D) undrelying"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Underlying is correct - U-N-D-E-R-L-Y-I-N-G. The tip of the iceberg means only a small part of a larger underlying problem is visible."},{"questionText":"Which is the CORRECT spelling of the key word in the proverb knowledge is power?","options":["A) enlightenment","B) enlightenement","C") enlightenmant","D) enlghtenment"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Enlightenment is correct - E-N-L-I-G-H-T-E-N-M-E-N-T. Knowledge is power relates to enlightenment and the value of learning."},{"questionText":"Which is the CORRECT spelling of the key word in the idiom to set the record straight?","options":["A) clarification","B) clarificasion","C") clarrification","D) clarificaton"],"correctAnswer":"A","topic":"Idioms and Proverbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Clarification is correct - C-L-A-R-I-F-I-C-A-T-I-O-N. To set the record straight means to provide clarification about a misunderstanding."}]