[{"questionText":"Which is the CORRECT spelling of the synonym for brave meaning showing courage?","options":["A) valiant","B) valliant","C) valieant","D) valiant"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Valiant is correct - V-A-L-I-A-N-T. Valiant means showing courage or determination. It is a synonym of brave."},{"questionText":"Which is the CORRECT spelling of the antonym of prosperity meaning severe poverty?","options":["A) adversity","B) adversety","C) addversity","D) adversitty"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Adversity is correct - A-D-V-E-R-S-I-T-Y. Adversity means difficulties or misfortune and is an antonym of prosperity."},{"questionText":"Which is the CORRECT spelling of the synonym for kind meaning generous in spirit?","options":["A) magnanimous","B) magnaminous","C") magnanimus","D) magnanimous"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Magnanimous is correct - M-A-G-N-A-N-I-M-O-U-S. Magnanimous means generous in forgiving and noble minded."},{"questionText":"Which is the CORRECT spelling of the antonym of abundance meaning extreme scarcity?","options":["A) scarcity","B) scarcety","C) scarsity","D) scarcitty"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Scarcity is correct - S-C-A-R-C-I-T-Y. Scarcity means insufficiency of supply and is an antonym of abundance."},{"questionText":"Which is the CORRECT spelling of the synonym for hatred meaning intense dislike?","options":["A) animosity","B) animmosity","C) animosety","D) animossity"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Animosity is correct - A-N-I-M-O-S-I-T-Y. Animosity means strong hostility or hatred toward someone."},{"questionText":"Which is the CORRECT spelling of the synonym for truthful meaning being honest?","options":["A) candid","B) cannddid","C) candide","D) khandid"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Candid is correct - C-A-N-D-I-D. Candid means truthful and straightforward. A synonym of honest."},{"questionText":"Which is the CORRECT spelling of the antonym of humility meaning excessive pride?","options":["A) arrogance","B) arrogence","C) arrrogance","D) aroggance"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Arrogance is correct - A-R-R-O-G-A-N-C-E. Double R. Arrogance means exaggerated pride and is the antonym of humility."},{"questionText":"Which is the CORRECT spelling of the synonym for fake meaning not genuine?","options":["A) spurious","B) spurrious","C) spuriuos","D) spurious"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Spurious is correct - S-P-U-R-I-O-U-S. Spurious means false or not what it appears to be. A synonym of fake."},{"questionText":"Which is the CORRECT spelling of the antonym of clarity meaning a state of confusion?","options":["A) ambiguity","B) ambiguety","C") ambiguiity","D) ambiguiity"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Ambiguity is correct - A-M-B-I-G-U-I-T-Y. Ambiguity means uncertainty of meaning and is an antonym of clarity."},{"questionText":"Which is the CORRECT spelling of the synonym for stubborn meaning firmly refusing to change?","options":["A) obstinate","B) obstinete","C) obstinnate","D) obstenate"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Obstinate is correct - O-B-S-T-I-N-A-T-E. Obstinate means stubbornly refusing to change. A synonym of stubborn."},{"questionText":"Which is the CORRECT spelling of the antonym of generosity meaning extreme unwillingness to give?","options":["A) parsimony","B) parsimoney","C) parsimonny","D) parsimoney"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Parsimony is correct - P-A-R-S-I-M-O-N-Y. Parsimony means extreme unwillingness to spend money. An antonym of generosity."},{"questionText":"Which is the CORRECT spelling of the synonym for temporary meaning not permanent?","options":["A) transient","B) transiant","C) transient","D) transitent"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Transient is correct - T-R-A-N-S-I-E-N-T. Transient means lasting only for a short time. A synonym of temporary."},{"questionText":"Which is the CORRECT spelling of the synonym for hostile meaning unfriendly?","options":["A) antagonistic","B") antagonistik","C) antaggonistic","D) antagonisttic"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Antagonistic is correct - A-N-T-A-G-O-N-I-S-T-I-C. Antagonistic means showing hostility. A synonym of hostile."},{"questionText":"Which is the CORRECT spelling of the antonym of stagnation meaning growth and activity?","options":["A) prosperity","B) prosperety","C) prosparety","D) prosperety"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Prosperity is correct - P-R-O-S-P-E-R-I-T-Y. Prosperity means success and well-being. An antonym of stagnation."},{"questionText":"Which is the CORRECT spelling of the synonym for mysterious meaning difficult to understand?","options":["A) enigmatic","B) enigmattic","C) enygmatic","D) enigmaatic"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Enigmatic is correct - E-N-I-G-M-A-T-I-C. Enigmatic means mysterious and difficult to interpret. A synonym of mysterious."},{"questionText":"Which is the CORRECT spelling of the antonym of careless meaning very careful?","options":["A) meticulous","B) metticulous","C) meticuluos","D) meticulouse"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Meticulous is correct - M-E-T-I-C-U-L-O-U-S. Meticulous means showing great attention to detail. An antonym of careless."},{"questionText":"Which is the CORRECT spelling of the synonym for talk meaning formal discussion?","options":["A) discourse","B") diskourse","C) discource","D) discourrse"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Discourse is correct - D-I-S-C-O-U-R-S-E. Discourse means written or spoken communication. A synonym of talk or discussion."},{"questionText":"Which is the CORRECT spelling of the antonym of simplicity meaning excessive complexity?","options":["A) complexity","B) compleksity","C) complexety","D) complxity"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Complexity is correct - C-O-M-P-L-E-X-I-T-Y. Complexity means the state of being intricate. An antonym of simplicity."},{"questionText":"Which is the CORRECT spelling of the synonym for lessen meaning to gradually decrease?","options":["A) diminish","B") dimenish","C) diminesh","D) diminnish"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Diminish is correct - D-I-M-I-N-I-S-H. Diminish means to make or become smaller. A synonym of lessen."},{"questionText":"Which is the CORRECT spelling of the antonym of cowardice meaning bravery in the face of danger?","options":["A) intrepidity","B") intrepedity","C) intreppidity","D) intrepidety"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Intrepidity is correct - I-N-T-R-E-P-I-D-I-T-Y. Intrepidity means fearlessness. An antonym of cowardice."},{"questionText":"Which is the CORRECT spelling of the synonym for beginning meaning the first part?","options":["A) inception","B") incepton","C) inceptshun","D) inceptionn"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Inception is correct - I-N-C-E-P-T-I-O-N. Inception means the beginning of something. A synonym of commencement."},{"questionText":"Which is the CORRECT spelling of the antonym of affluence meaning deep poverty?","options":["A) penury","B) penurey","C) pennury","D) penurie"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Penury is correct - P-E-N-U-R-Y. Penury means extreme poverty. An antonym of affluence or wealth."},{"questionText":"Which is the CORRECT spelling of the synonym for disagree meaning to argue against?","options":["A) dissent","B) dissent","C) disent","D) diissent"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Dissent is correct - D-I-S-S-E-N-T. Double S. Dissent means to hold or express opinions different from those generally held."},{"questionText":"Which is the CORRECT spelling of the antonym of modesty meaning vanity?","options":["A) conceit","B) conceite","C) conseit","D) conceeit"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Conceit is correct - C-O-N-C-E-I-T. Conceit means excessive pride in oneself. An antonym of modesty."},{"questionText":"Which is the CORRECT spelling of the synonym for lively meaning very energetic?","options":["A) vivacious","B) vivacious","C") vivaciuos","D) vivaceus"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Vivacious is correct - V-I-V-A-C-I-O-U-S. Vivacious means attractively lively and animated. A synonym of lively."},{"questionText":"Which is the CORRECT spelling of the antonym of loyalty meaning betrayal?","options":["A) treachery","B) treachrey","C) treachery","D) treacherry"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Treachery is correct - T-R-E-A-C-H-E-R-Y. Treachery means betrayal of trust. An antonym of loyalty."},{"questionText":"Which is the CORRECT spelling of the synonym for chaos meaning complete disorder?","options":["A) pandemonium","B) pandemoniem","C") pandemmonium","D) pandaemonium"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Pandemonium is correct - P-A-N-D-E-M-O-N-I-U-M. Pandemonium means a state of wild confusion or noise. A synonym of chaos."},{"questionText":"Which is the CORRECT spelling of the antonym of courage meaning extreme fear?","options":["A) trepidation","B") trepidation","C) trepidashun","D) treppidation"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Trepidation is correct - T-R-E-P-I-D-A-T-I-O-N. Trepidation means a feeling of fear or anxiety. An antonym of courage."},{"questionText":"Which is the CORRECT spelling of the synonym for wise meaning having deep knowledge?","options":["A) sagacious","B) sagacious","C") sagacuios","D) sagatious"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Sagacious is correct - S-A-G-A-C-I-O-U-S. Sagacious means having good judgment and wisdom. A synonym of wise."},{"questionText":"Which is the CORRECT spelling of the antonym of harmony meaning strong disagreement?","options":["A) discord","B") discored","C) disscord","D) diskord"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Discord is correct - D-I-S-C-O-R-D. Discord means disagreement between people. An antonym of harmony."},{"questionText":"Which is the CORRECT spelling of the synonym for old meaning very ancient?","options":["A) antiquated","B) antiqated","C") antiquaited","D) antiiquated"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Antiquated is correct - A-N-T-I-Q-U-A-T-E-D. Antiquated means very old or no longer suitable. A synonym of archaic."},{"questionText":"Which is the CORRECT spelling of the antonym of constructive meaning harmful?","options":["A) detrimental","B) detramental","C) detrimentel","D) detrimentall"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Detrimental is correct - D-E-T-R-I-M-E-N-T-A-L. Detrimental means causing harm or damage. An antonym of constructive."},{"questionText":"Which is the CORRECT spelling of the synonym for unbelievable meaning impossible to believe?","options":["A) incredulous","B) incredulous","C") incredulous","D) increduluos"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Incredulous is correct - I-N-C-R-E-D-U-L-O-U-S. Incredulous means unwilling or unable to believe something. A synonym of disbelieving."},{"questionText":"Which is the CORRECT spelling of the antonym of peace meaning active conflict?","options":["A) hostility","B) hostilety","C) hostility","D) hostilety"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Hostility is correct - H-O-S-T-I-L-I-T-Y. Hostility means aggressive or unfriendly behaviour. An antonym of peace."},{"questionText":"Which is the CORRECT spelling of the synonym for show meaning to display clearly?","options":["A) manifest","B") mannifest","C) manfest","D) maniffest"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Manifest is correct - M-A-N-I-F-E-S-T. To manifest means to display or show clearly. A synonym of show or reveal."},{"questionText":"Which is the CORRECT spelling of the antonym of noise meaning complete quiet?","options":["A) tranquility","B") tranquillity","C) tranquility","D) tranquility"],"correctAnswer":"B","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Tranquillity is correct - T-R-A-N-Q-U-I-L-L-I-T-Y. Double L. Tranquillity means a state of calm and quiet. An antonym of noise."},{"questionText":"Which is the CORRECT spelling of the synonym for stop meaning to prevent from continuing?","options":["A) curtail","B) kurtail","C) curtale","D) curtayle"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Curtail is correct - C-U-R-T-A-I-L. To curtail means to reduce or restrict. A synonym of stop or cut short."},{"questionText":"Which is the CORRECT spelling of the antonym of order meaning wild confusion?","options":["A) anarchy","B) anarky","C) anarchey","D) annarchy"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Anarchy is correct - A-N-A-R-C-H-Y. Anarchy means a state of disorder. An antonym of order."},{"questionText":"Which is the CORRECT spelling of the synonym for argue meaning to discuss forcefully?","options":["A) contend","B") contende","C) conttend","D) conttend"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Contend is correct - C-O-N-T-E-N-D. To contend means to struggle or argue. A synonym of argue or debate."},{"questionText":"Which is the CORRECT spelling of the antonym of clarity meaning vagueness?","options":["A) obscurity","B") obsscurity","C) obscureity","D) obscurety"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Obscurity is correct - O-B-S-C-U-R-I-T-Y. Obscurity means the state of being unknown or unclear. An antonym of clarity."},{"questionText":"Which is the CORRECT spelling of the synonym for help meaning to provide assistance?","options":["A) facilitate","B) facilittate","C") facilitait","D) facilatate"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Facilitate is correct - F-A-C-I-L-I-T-A-T-E. To facilitate means to make an action or process easier. A synonym of help."},{"questionText":"Which is the CORRECT spelling of the antonym of success meaning total failure?","options":["A) fiasco","B") fiasco","C) fiyasco","D) fiyascco"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Fiasco is correct - F-I-A-S-C-O. Fiasco means a complete failure. An antonym of success."},{"questionText":"Which is the CORRECT spelling of the synonym for short-lived meaning not lasting long?","options":["A) ephemeral","B) ephemeral","C") ephermeral","D) ephimeral"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Ephemeral is correct - E-P-H-E-M-E-R-A-L. Ephemeral means lasting for a very short time. A synonym of short-lived or transient."},{"questionText":"Which is the CORRECT spelling of the antonym of lethargy meaning high energy?","options":["A) vitality","B") vitalety","C) vitallity","D) vitalety"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Vitality is correct - V-I-T-A-L-I-T-Y. Vitality means liveliness and energy. An antonym of lethargy."},{"questionText":"Which is the CORRECT spelling of the synonym for flexible meaning able to adapt?","options":["A) versatile","B") versitile","C) versattile","D) versatill"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Versatile is correct - V-E-R-S-A-T-I-L-E. Versatile means able to adapt to many different situations. A synonym of flexible."},{"questionText":"Which is the CORRECT spelling of the antonym of approval meaning strong objection?","options":["A) censure","B) censhure","C") censurre","D) cencure"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Censure is correct - C-E-N-S-U-R-E. Censure means strong disapproval. An antonym of approval."},{"questionText":"Which is the CORRECT spelling of the synonym for truthful meaning honest and open?","options":["A) forthright","B) forthrigh","C") forthriight","D) forthrite"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Forthright is correct - F-O-R-T-H-R-I-G-H-T. Forthright means direct and outspoken. A synonym of honest and candid."},{"questionText":"Which is the CORRECT spelling of the antonym of doubt meaning absolute certainty?","options":["A) conviction","B") convicshun","C) convickshon","D) convictioon"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Conviction is correct - C-O-N-V-I-C-T-I-O-N. Conviction means a firm belief. An antonym of doubt."},{"questionText":"Which is the CORRECT spelling of the synonym for proud meaning feeling self-respect?","options":["A) dignified","B) dignifed","C") diggnified","D) dignifyd"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Dignified is correct - D-I-G-N-I-F-I-E-D. Dignified means having or showing dignity. A synonym of proud or distinguished."},{"questionText":"Which is the CORRECT spelling of the antonym of innocence meaning guilt or wrongdoing?","options":["A) culpability","B) culpabilety","C) culpabillity","D) culpabilty"],"correctAnswer":"A","topic":"Synonyms and Antonyms","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Culpability is correct - C-U-L-P-A-B-I-L-I-T-Y. Culpability means responsibility for a fault. An antonym of innocence."}]