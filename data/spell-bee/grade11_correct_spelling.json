[{"questionText":"Which is the correct spelling?","options":["A) Accomodate","B) Accommodate","C) Acommodate","D) Accommodaet"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"ACCOMMODATE has double C and double M — a common misspelling. Remember: it accommodates two Cs and two Ms."},{"questionText":"Which word is spelled correctly?","options":["A) Conscientious","B) Concientious","C) Consciencious","D) Conscienctious"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"advanced adjective spelling","difficulty":"Advanced","explanation":"CONSCIENTIOUS is spelled with SCIENCE in the middle — from Latin CONSCIENTIA (conscience). It means being thorough and diligent."},{"questionText":"Select the correctly spelled word:","options":["A) Entrepreneur","B) Entrepeneur","C) Entreprenuer","D) Entreperneur"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"French-origin business words","difficulty":"Advanced","explanation":"ENTREPRENEUR comes from French and means a person who starts a business. The -NEUR ending is often misspelled."},{"questionText":"Which spelling is correct?","options":["A) Occurrance","B) Occurance","C) Occurrence","D) Occurence"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"OCCURRENCE has double C and double R. The suffix -ENCE (not -ANCE) is correct here."},{"questionText":"Identify the correctly spelled word:","options":["A) Supercede","B) Superceed","C): Supersede","D) Superseed"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"Latin-origin verbs","difficulty":"Advanced","explanation":"SUPERSEDE is the only correct spelling — from Latin SUPERSEDERE (to sit above). SUPERCEDE is a common misspelling."},{"questionText":"Which word is spelled correctly?","options":["A) Liason","B) Liaison","C) Liasion","D) Liaisson"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"French loanwords","difficulty":"Advanced","explanation":"LIAISON is a French loanword meaning a communication link or a close relationship. The two Is and silent S make it tricky."},{"questionText":"Select the correctly spelled word:","options":["A) Millenium","B) Milennium","C) Millennium","D) Milenneum"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"MILLENNIUM has double L and double N — from Latin MILLE (thousand) + ANNUM (year). It refers to a period of one thousand years."},{"questionText":"Which spelling is correct?","options":["A) Recomend","B) Recommend","C) Reccommend","D) Recommand"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"RECOMMEND has one C and double M — re-COM-MEND. A common error is writing double C or single M."},{"questionText":"Identify the correctly spelled word:","options":["A) Adress","B) Addres","C) Address","D) Addrress"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"ADDRESS has double D and double S — ad-DRESS. Both sets of double letters are needed."},{"questionText":"Which word is correctly spelled?","options":["A) Seperate","B) Seperrate","C) Separate","D) Seperete"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"vowel confusion","difficulty":"Foundation","explanation":"SEPARATE contains the word PAR in the middle — se-PAR-ate. Remembering this helps avoid the common error of writing SEPERATE."},{"questionText":"Select the correct spelling:","options":["A) Priviledge","B) Privilege","C) Privelege","D) Privledge"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"common misspellings","difficulty":"Foundation","explanation":"PRIVILEGE has no D — it ends in -ILEGE, not -ILEDGE. It comes from Latin PRIVILEGIUM."},{"questionText":"Which spelling is correct?","options":["A) Pronounciation","B) Pronunciation","C) Pronunciaton","D) Pronounciation"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"noun spelling vs verb form","difficulty":"Advanced","explanation":"PRONUNCIATION has no O after PRON — it comes from PRONOUNCE but drops the O in the noun form. Many spell it PRONOUNCIATION erroneously."},{"questionText":"Identify the correctly spelled word:","options":["A) Maintanance","B) Maintenance","C) Maintainance","D) Maintanence"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"noun endings","difficulty":"Advanced","explanation":"MAINTENANCE is spelled with -ENANCE at the end. It comes from MAINTAIN but the vowel changes in the noun form."},{"questionText":"Which word is correctly spelled?","options":["A) Recieve","B) Receive","C) Recive","D) Receeve"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"i before e rule","difficulty":"Foundation","explanation":"RECEIVE follows the rule: I before E except after C. After C, the order reverses to E before I — re-CEIVE."},{"questionText":"Select the correct spelling:","options":["A) Aquintance","B) Acquaintance","C) Acquaintence","D) Aquaintance"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"silent letter words","difficulty":"Advanced","explanation":"ACQUAINTANCE has a silent C after the Q (acquaint) and ends in -ANCE, not -ENCE."},{"questionText":"Which spelling is correct?","options":["A) Exhileration","B) Exhilaration","C) Exhiliration","D) Exhileration"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"emotion word spelling","difficulty":"Advanced","explanation":"EXHILARATION contains HILAR (from Latin HILARIS, cheerful). The spelling -ILAR- is key: exhiLARation."},{"questionText":"Identify the correctly spelled word:","options":["A) Irresistable","B) Irresistible","C) Iresistible","D) Irresisteable"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"-ible vs -able","difficulty":"Advanced","explanation":"IRRESISTIBLE ends in -IBLE, not -ABLE. When the root word ends in -IST, the suffix is usually -IBLE."},{"questionText":"Which word is correctly spelled?","options":["A) Harrass","B) Harass","C) Harras","D) Harrase"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"single vs double letters","difficulty":"Foundation","explanation":"HARASS has one R and double S — unlike EMBARRASS which has double R and double S. A common error is writing double R."},{"questionText":"Select the correct spelling:","options":["A) Beleive","B) Belive","C) Believe","D) Beleeve"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"ie/ei patterns","difficulty":"Foundation","explanation":"BELIEVE follows the I before E rule — beLIEve. The LIE in the middle can also help you remember: beLIEve."},{"questionText":"Which spelling is correct?","options":["A) Indispensible","B) Indispensable","C) Indispenseable","D) Indispencable"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"-ible vs -able","difficulty":"Advanced","explanation":"INDISPENSABLE ends in -ABLE. When the root is DISPENSE (ending in E), drop the E and add -ABLE."},{"questionText":"Identify the correctly spelled word:","options":["A) Equilvalent","B) Equivalent","C) Equivlant","D) Equivalant"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"scientific vocabulary spelling","difficulty":"Advanced","explanation":"EQUIVALENT ends in -ALENT, from Latin AEQUIVALERE. The A in the final syllable is often misspelled as E."},{"questionText":"Which word is correctly spelled?","options":["A) Bureacracy","B) Bureaucracy","C) Beaurocracy","D) Burocracy"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"French-origin political words","difficulty":"Olympiad","explanation":"BUREAUCRACY begins with BUREAU (a French word for desk or office). The BURE-AU spelling is a common stumbling block."},{"questionText":"Select the correct spelling:","options":["A) Embarassment","B) Embarrassment","C) Embarrasment","D) Embarrasement"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"EMBARRASSMENT has double R and double S — em-BAR-RASS-ment. Remember both sets of doubles."},{"questionText":"Which spelling is correct?","options":["A) Foreseeable","B) Foreseable","C) Forseeable","D) Foreseeible"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"compound word spelling","difficulty":"Advanced","explanation":"FORESEEABLE keeps the full word FORESEE and adds -ABLE: fore-SEE-able. The double E is retained."},{"questionText":"Identify the correctly spelled word:","options":["A) Truely","B) Truly","C) Truley","D) Trully"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"dropping silent E","difficulty":"Foundation","explanation":"TRULY drops the E from TRUE when adding -LY. This is an exception to the usual pattern of keeping the E."},{"questionText":"Which word is correctly spelled?","options":["A) Consceince","B) Conscience","C) Consciance","D) Consience"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"moral vocabulary spelling","difficulty":"Advanced","explanation":"CONSCIENCE contains SCIENCE in the middle — con-SCIENCE. It means the moral sense of right and wrong."},{"questionText":"Select the correct spelling:","options":["A) Perseverence","B) Persiverance","C) Perseverance","D) Perseverance"],"correctAnswer":"D","topic":"Correct Spelling Identification","subTopic":"-ance vs -ence","difficulty":"Advanced","explanation":"PERSEVERANCE ends in -ANCE, not -ENCE. It comes from PERSEVERE + -ANCE and means persistence despite difficulty."},{"questionText":"Which spelling is correct?","options":["A) Liquefy","B) Liquify","C) Liquefie","D) Liqufy"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"-ify vs -efy","difficulty":"Olympiad","explanation":"LIQUEFY is one of the few -EFY verbs (not -IFY). Others: STUPEFY, RAREFY, PUTREFY. Most -fy words use -IFY."},{"questionText":"Identify the correctly spelled word:","options":["A) Definately","B) Definitley","C) Definitely","D) Definitaly"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"common misspellings","difficulty":"Foundation","explanation":"DEFINITELY is one of the most commonly misspelled words. It has FINITE in the middle — de-FINITE-ly."},{"questionText":"Which word is correctly spelled?","options":["A) Occurence","B) Occurrence","C) Occurance","D) Occurrrance"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"OCCURRENCE requires double C and double R — oc-CUR-RENCE. The -ENCE ending (not -ANCE) is also important."},{"questionText":"Select the correct spelling:","options":["A) Necesary","B) Necesary","C) Necessary","D) Neccesary"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"single and double letters","difficulty":"Foundation","explanation":"NECESSARY has one C and double S — ne-C-ESSARY. A helpful mnemonic: it is Necessary to wear one Collar and two Socks."},{"questionText":"Which spelling is correct?","options":["A) Rhythem","B) Rythm","C) Rhythm","D) Rhythmn"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"Greek-origin words","difficulty":"Advanced","explanation":"RHYTHM has no vowel except the Y, and ends in -THM. It is one of the longest common English words without a traditional vowel."},{"questionText":"Identify the correctly spelled word:","options":["A) Succesful","B) Successful","C) Successfull","D) Sucsessful"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"SUCCESSFUL has double C and double S — suc-CESS-ful. The suffix -FUL has only one L."},{"questionText":"Which word is correctly spelled?","options":["A) Questionaire","B) Questionnaire","C) Questionair","D) Questionare"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"French loanword spelling","difficulty":"Advanced","explanation":"QUESTIONNAIRE is a French loanword with double N and -AIRE ending. It means a set of questions used for research."},{"questionText":"Select the correct spelling:","options":["A) Fourty","B) Forty","C) Fourtie","D) Fortey"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"number spelling","difficulty":"Foundation","explanation":"FORTY has no U — unlike FOUR and FOURTEEN which do. This is one of the most common number spelling mistakes."},{"questionText":"Which spelling is correct?","options":["A) Phenomemon","B) Phenomenon","C) Phenomenun","D) Phenomonon"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"Greek-origin scientific words","difficulty":"Advanced","explanation":"PHENOMENON is from Greek and ends in -ON. Its plural, PHENOMENA, is also commonly misused as singular."},{"questionText":"Identify the correctly spelled word:","options":["A) Jewelery","B) Jewlery","C) Jewellery","D) Jewelrey"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"British spelling","difficulty":"Advanced","explanation":"JEWELLERY (British English) has double L and -ERY. American English uses JEWELRY (one L). The British form is standard in India."},{"questionText":"Which word is correctly spelled?","options":["A) Wierd","B) Wieird","C) Weird","D) Weerd"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"ie/ei exception","difficulty":"Foundation","explanation":"WEIRD is an exception to the I-before-E rule — it has EI without a C before it. Remember: WEIRD is just weird."},{"questionText":"Select the correct spelling:","options":["A) Mischevious","B) Mischeivous","C) Mischievous","D) Mischivious"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"common misspellings","difficulty":"Advanced","explanation":"MISCHIEVOUS has four syllables and ends in -VOUS, not -VIOUS. A common error is adding an extra I to make it sound like mis-CHEEV-ee-us."},{"questionText":"Which spelling is correct?","options":["A) Sacrilegious","B) Sacreligious","C) Sacrilegeous","D) Sacrelagious"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"religious vocabulary spelling","difficulty":"Olympiad","explanation":"SACRILEGIOUS comes from SACRILEGE + -OUS. Note the order: SACRI-LEGE-OUS, not sacreLIGIOUS. Many confuse it with RELIGIOUS."},{"questionText":"Identify the correctly spelled word:","options":["A) Vaccum","B) Vacuum","C) Vacuumm","D) Vacum"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"Latin-origin words","difficulty":"Foundation","explanation":"VACUUM comes from Latin VACUUS (empty) and has double U — vacu-UM. It is one of the few English words with UU."},{"questionText":"Which word is correctly spelled?","options":["A) Occurrance","B) Occurance","C) Occurrence","D) Occurence"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"double letters recap","difficulty":"Foundation","explanation":"OCCURRENCE: double C, double R, -ENCE ending. All three features are commonly misspelled."},{"questionText":"Select the correct spelling:","options":["A) Persuation","B) Persuasion","C) Persuasoin","D) Persuesion"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"-sion vs -tion","difficulty":"Advanced","explanation":"PERSUASION ends in -ASION, from PERSUADE. When the verb ends in -ADE, the noun typically uses -ASION."},{"questionText":"Which spelling is correct?","options":["A) Hipocrisy","B) Hypocricy","C) Hypocrisy","D) Hipocracy"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"Greek-origin words","difficulty":"Advanced","explanation":"HYPOCRISY begins with HYPO- (Greek: under) and ends in -ISY. It means claiming to have moral standards one does not hold."},{"questionText":"Identify the correctly spelled word:","options":["A) Collectible","B) Collectable","C) Colectable","D) Collecteable"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"-ible vs -able","difficulty":"Advanced","explanation":"COLLECTIBLE is preferred in standard usage, ending in -IBLE. Though -ABLE is also used colloquially, -IBLE is the standard form."},{"questionText":"Which word is correctly spelled?","options":["A) Mnemonic","B) Nnemonic","C) Mnemmonik","D) Nemonik"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"silent initial letters","difficulty":"Advanced","explanation":"MNEMONIC has a silent M at the start — it is pronounced /nɪˈmɒnɪk/. It comes from Greek MNEME (memory)."},{"questionText":"Select the correct spelling:","options":["A) Knowledgeable","B) Knowledgable","C) Knowlegeable","D) Knowledgeable"],"correctAnswer":"D","topic":"Correct Spelling Identification","subTopic":"keeping silent E","difficulty":"Advanced","explanation":"KNOWLEDGEABLE retains the E from KNOWLEDGE before -ABLE to keep the soft G sound. Without the E, the G would sound hard."},{"questionText":"Which spelling is correct?","options":["A) Ommission","B) Omission","C) Omision","D) Omissoin"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"single vs double letters","difficulty":"Foundation","explanation":"OMISSION has one M and double S — o-MIS-SION. From Latin OMITTERE (to leave out)."},{"questionText":"Identify the correctly spelled word:","options":["A) Exagerate","B) Exaggerate","C) Exaggarate","D) Exaggerrate"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"double letters","difficulty":"Foundation","explanation":"EXAGGERATE has double G — ex-AGG-erate. From Latin EXAGGERARE (to heap up). Many write only one G."},{"questionText":"Which is the correct spelling of the word meaning a formal public speech?","options":["A) Orration","B) Oration","C) Oracion","D) Orasion"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"formal language spelling","difficulty":"Advanced","explanation":"ORATION (from Latin ORARE, to speak) means a formal speech. It ends in -ATION: or-ATION."}]