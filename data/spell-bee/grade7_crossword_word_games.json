[{"questionText":"Which is the CORRECT spelling of the word meaning a puzzle where words are fitted into a grid?","options":["A) crossword","B) crossworde","C) crosswoord","D) crosword"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Crossword is correct - C-R-O-S-S-W-O-R-D. Double S. A crossword is a word puzzle in which words interlocking in a grid."},{"questionText":"Which is the CORRECT spelling of the word meaning a word hidden in a grid of letters?","options":["A) wordsearch","B) wordsearch","C) word-search","D) wordsearsh"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Wordsearch is correct - W-O-R-D-S-E-A-R-C-H. A wordsearch is a puzzle where words are hidden in a grid of letters."},{"questionText":"Which is the CORRECT spelling of the word meaning letters given in a puzzle to complete?","options":["A) clue","B) clew","C) clue","D) clu"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Clue is correct - C-L-U-E. A clue is a hint given in a word puzzle to help find the answer."},{"questionText":"Which is the CORRECT spelling of the word for a block in a crossword grid?","options":["A) square","B) sqare","C) squair","D) squaer"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Square is correct - S-Q-U-A-R-E. In a crossword each letter occupies one square."},{"questionText":"Which is the CORRECT spelling of the word meaning an image that represents a word?","options":["A) pictogram","B) pictogramm","C) pictograam","D) picktogram"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Pictogram is correct - P-I-C-T-O-G-R-A-M. A pictogram is a symbol or character representing a word or idea."},{"questionText":"Which is the CORRECT spelling of the word for the direction in a crossword?","options":["A) horizontal","B) horisontal","C) horiziontal","D) horizonal"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Horizontal is correct - H-O-R-I-Z-O-N-T-A-L. In crosswords words go either horizontal meaning across or vertical meaning down."},{"questionText":"Which is the CORRECT spelling of the word meaning arranged in columns?","options":["A) vertical","B) vertickle","C) vertcal","D) verticle"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Vertical is correct - V-E-R-T-I-C-A-L. Vertical means arranged from top to bottom. In crosswords this is the down direction."},{"questionText":"Which is the CORRECT spelling of the word meaning the answer to a puzzle?","options":["A) solution","B) solushun","C) solutioin","D) soluton"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Solution is correct - S-O-L-U-T-I-O-N. A solution is the answer to a problem or puzzle."},{"questionText":"Which is the CORRECT spelling of the word meaning a letter that links two words in a crossword?","options":["A) intersection","B) intersecton","C) intersecshun","D) inntersection"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Intersection is correct - I-N-T-E-R-S-E-C-T-I-O-N. In a crossword words intersect where they share a common letter."},{"questionText":"Which is the CORRECT spelling of the word meaning an alphabetical list of words?","options":["A) vocabulary","B) vocaboulary","C) vocabularry","D) vocabolary"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Vocabulary is correct - V-O-C-A-B-U-L-A-R-Y. Vocabulary refers to all the words known to a person or used in a particular context."},{"questionText":"Which is the CORRECT spelling of the word for a word that is the reverse of another?","options":["A) palindrome","B) pallindrome","C) palindrome","D) palindrome"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Palindrome is correct - P-A-L-I-N-D-R-O-M-E. A palindrome reads the same forwards and backwards like racecar."},{"questionText":"Which is the CORRECT spelling of the word meaning an extra letter not used in the answer?","options":["A) distractor","B) distracttor","C") distracker","D) distractour"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Distractor is correct - D-I-S-T-R-A-C-T-O-R. In multiple choice word games distractors are incorrect options designed to mislead."},{"questionText":"Which is the CORRECT spelling of the word meaning an abbreviation using initials?","options":["A) acronym","B") accronym","C) acromnym","D) acronnyms"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Acronym is correct - A-C-R-O-N-Y-M. An acronym is an abbreviation formed from the initial letters of words like NASA."},{"questionText":"Which is the CORRECT spelling of the word meaning a list of synonyms?","options":["A) thesaurus","B) thessaurus","C") thesauruss","D) thesaurus"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Thesaurus is correct - T-H-E-S-A-U-R-U-S. A thesaurus is a reference book listing synonyms and antonyms."},{"questionText":"Which is the CORRECT spelling of the word meaning a word made by rearranging letters?","options":["A) anagram","B) anigramme","C) annagram","D) anagramm"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Anagram is correct - A-N-A-G-R-A-M. An anagram is a word formed by rearranging the letters of another word."},{"questionText":"Which is the CORRECT spelling of the word meaning a riddle in the form of a picture?","options":["A) rebus","B") rebus","C) reebus","D) rebus"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Rebus is correct - R-E-B-U-S. A rebus is a puzzle in which words are represented by pictures or symbols."},{"questionText":"Which is the CORRECT spelling of the word meaning the position of letters in a word?","options":["A) sequence","B) sequance","C") seequence","D) sequennce"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Sequence is correct - S-E-Q-U-E-N-C-E. Sequence refers to the particular order in which things are arranged."},{"questionText":"Which is the CORRECT spelling of the word meaning a combination of letters forming a word?","options":["A) combination","B) combinasion","C) combinnation","D) combinashun"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Combination is correct - C-O-M-B-I-N-A-T-I-O-N. A combination is a set of things put together."},{"questionText":"Which is the CORRECT spelling of the word meaning a game where letters are placed on a board?","options":["A) scrabble","B) scrrabble","C") scrablle","D) scrable"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Scrabble is correct - S-C-R-A-B-B-L-E. Scrabble is a word game in which players place lettered tiles on a board. Double B."},{"questionText":"Which is the CORRECT spelling of the word meaning a symbol that represents a sound?","options":["A) phoneme","B) phoneem","C") phonneme","D) foneme"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Phoneme is correct - P-H-O-N-E-M-E. A phoneme is the smallest unit of sound in a language."},{"questionText":"Which is the CORRECT spelling of the word meaning a word representing what it sounds like?","options":["A) onomatopoeia","B) onomatopoeia","C) onomatopeia","D) onomatopoeya"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Onomatopoeia is correct - O-N-O-M-A-T-O-P-O-E-I-A. Onomatopoeia means words that sound like what they describe."},{"questionText":"Which is the CORRECT spelling of the word meaning a hint or indication in a puzzle?","options":["A) indication","B) indicasion","C") indecation","D) indicaton"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Indication is correct - I-N-D-I-C-A-T-I-O-N. An indication is a sign or hint that points toward a specific answer."},{"questionText":"Which is the CORRECT spelling of the word meaning a shortened form of a word?","options":["A) abbreviation","B) abreviasion","C") abbreviashun","D) abreviation"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Abbreviation is correct - A-B-B-R-E-V-I-A-T-I-O-N. Double B. An abbreviation is a shortened form of a word or phrase."},{"questionText":"Which is the CORRECT spelling of the word meaning a diagram that connects ideas?","options":["A) concept map","B) koncept map","C") conncept map","D) consept map"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Concept map is correct. A concept map is a diagram that shows relationships between ideas."},{"questionText":"Which is the CORRECT spelling of the word meaning a word that describes an image?","options":["A) caption","B) capshun","C") captiion","D) cappttion"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Caption is correct - C-A-P-T-I-O-N. A caption is text that describes or explains an image or illustration."},{"questionText":"Which is the CORRECT spelling of the word meaning the act of interpreting signs?","options":["A) deciphering","B) decifering","C) decypherring","D) deciphiring"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Deciphering is correct - D-E-C-I-P-H-E-R-I-N-G. Deciphering means interpreting or solving a coded message."},{"questionText":"Which is the CORRECT spelling of the word meaning a picture that tells a story?","options":["A) illustration","B) illustrasion","C") illustrattion","D) illusration"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Illustration is correct - I-L-L-U-S-T-R-A-T-I-O-N. Double L. An illustration is a picture or drawing explaining or decorating text."},{"questionText":"Which is the CORRECT spelling of the word meaning an image showing a set of objects?","options":["A) diagram","B) diagramm","C") daiagram","D) diagramme"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Diagram is correct - D-I-A-G-R-A-M. A diagram is a simplified drawing showing the appearance or workings of something."},{"questionText":"Which is the CORRECT spelling of the word meaning a symbol used to mark something?","options":["A) annotation","B) annotasion","C") anottation","D) annotaton"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Annotation is correct - A-N-N-O-T-A-T-I-O-N. Double N. An annotation is a note or label added to explain or describe."},{"questionText":"Which is the CORRECT spelling of the word meaning a puzzle with missing words?","options":["A) cloze","B) close","C") cloze","D) klowse"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Cloze is correct - C-L-O-Z-E. A cloze test is a reading exercise where words have been removed and must be filled in."},{"questionText":"Which is the CORRECT spelling of the word meaning a combination of two pictures representing a word?","options":["A) compound","B) compounnd","C) compoound","D) conpound"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Compound is correct - C-O-M-P-O-U-N-D. In picture puzzles a compound image represents a compound word."},{"questionText":"Which is the CORRECT spelling of the word meaning to recognise by sight?","options":["A) identify","B) identyfie","C") identifyy","D) identafy"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Identify is correct - I-D-E-N-T-I-F-Y. To identify means to recognise or establish the identity of something."},{"questionText":"Which is the CORRECT spelling of the word meaning a set of related words?","options":["A) category","B) catigory","C") cattegory","D) cateegory"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Category is correct - C-A-T-E-G-O-R-Y. A category is a class or group of things sharing common attributes."},{"questionText":"Which is the CORRECT spelling of the word meaning an organised set of letters?","options":["A) alphabet","B") alfabet","C) alphbet","D) alphabeat"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Alphabet is correct - A-L-P-H-A-B-E-T. The alphabet is the complete set of letters used in a writing system."},{"questionText":"Which is the CORRECT spelling of the word meaning a phrase hidden in a sentence?","options":["A) embedded","B") embeded","C) embeddded","D) embedde"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Embedded is correct - E-M-B-E-D-D-E-D. Double D. Embedded means fixed firmly within something or hidden inside."},{"questionText":"Which is the CORRECT spelling of the word meaning a visual aid showing word connections?","options":["A) mindmap","B") minnd map","C) mind-mapp","D) miindmap"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Mindmap is correct - M-I-N-D-M-A-P. A mindmap is a diagram that visually organises information around a central concept."},{"questionText":"Which is the CORRECT spelling of the word meaning to interpret a code?","options":["A) decipher","B) decypher","C") diccipher","D) deciphher"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Decipher is correct - D-E-C-I-P-H-E-R. To decipher means to convert a coded message into understandable language."},{"questionText":"Which is the CORRECT spelling of the word meaning a word or phrase that reads the same backwards?","options":["A) palindrome","B) pallinndrome","C") palendrome","D) palindrome"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Palindrome is correct - P-A-L-I-N-D-R-O-M-E. A palindrome reads the same forwards and backwards such as madam."},{"questionText":"Which is the CORRECT spelling of the word meaning a hint in a picture puzzle?","options":["A) visual","B") visueal","C) visuel","D) vissual"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Visual is correct - V-I-S-U-A-L. Visual means relating to seeing or sight. A visual clue is a picture-based hint."},{"questionText":"Which is the CORRECT spelling of the word meaning to mix up letters?","options":["A) scramble","B") scrambel","C) scrammble","D) scramble"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Scramble is correct - S-C-R-A-M-B-L-E. To scramble means to mix up in a disorderly way. Scrambled words are used in word puzzles."},{"questionText":"Which is the CORRECT spelling of the word meaning to put in order of the alphabet?","options":["A) alphabetise","B") alphabetize","C) alphabetise","D) alphebitize"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Alphabetise is correct - A-L-P-H-A-B-E-T-I-S-E. Also spelled alphabetize. To alphabetise means to arrange in alphabetical order."},{"questionText":"Which is the CORRECT spelling of the word meaning a type of word puzzle using pictures?","options":["A) pictorial","B") pictoreial","C) picktorial","D) picttorial"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Pictorial is correct - P-I-C-T-O-R-I-A-L. Pictorial means relating to or using pictures."},{"questionText":"Which is the CORRECT spelling of the word meaning a set of instructions for a game?","options":["A) instructions","B") instructsions","C) instrucsions","D) instrutions"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Instructions is correct - I-N-S-T-R-U-C-T-I-O-N-S. Instructions are directions telling someone how to do or use something."},{"questionText":"Which is the CORRECT spelling of the word meaning a game involving guessing the word?","options":["A) charades","B") charrades","C) charaides","D) charrades"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Charades is correct - C-H-A-R-A-D-E-S. Charades is a game where players act out words or phrases for others to guess."},{"questionText":"Which is the CORRECT spelling of the word meaning a repeated pattern in writing?","options":["A) motif","B") moteef","C) motiif","D) motife"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Motif is correct - M-O-T-I-F. A motif is a distinctive pattern or recurring element in art or literature."},{"questionText":"Which is the CORRECT spelling of the word meaning a letter used more than once?","options":["A) duplicate","B") duplecate","C) duplicatte","D) duuplicate"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Duplicate is correct - D-U-P-L-I-C-A-T-E. A duplicate is an exact copy or reproduction of something."},{"questionText":"Which is the CORRECT spelling of the word meaning the clue number in a crossword?","options":["A) reference","B") refference","C) refernece","D) referrence"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Reference is correct - R-E-F-E-R-E-N-C-E. In crosswords the reference number identifies the position of a clue."},{"questionText":"Which is the CORRECT spelling of the word meaning pictures used to communicate?","options":["A) iconography","B") iconaggraphy","C) iconografy","D) iconographey"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Iconography is correct - I-C-O-N-O-G-R-A-P-H-Y. Iconography is the use or study of images and symbols in visual arts."},{"questionText":"Which is the CORRECT spelling of the word meaning a symbol or character in a puzzle?","options":["A) glyph","B") gliff","C) glyffe","D) glyf"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Glyph is correct - G-L-Y-P-H. A glyph is a symbol or character used in a writing system or puzzle."},{"questionText":"Which is the CORRECT spelling of the word meaning to work out a hidden meaning?","options":["A) interpret","B) intrepret","C") interpretate","D) innterpreat"],"correctAnswer":"A","topic":"Crossword and Picture-Based Word Games","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Interpret is correct - I-N-T-E-R-P-R-E-T. To interpret means to explain the meaning of information or symbols."}]