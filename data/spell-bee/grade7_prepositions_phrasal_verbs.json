[{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to investigate?","options":["A) look into","B") lok into","C) looke into","D) look innto"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Look into is correct - L-O-O-K I-N-T-O. Look into is a phrasal verb meaning to investigate or examine."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to endure?","options":["A) put up with","B") putt up with","C) put up wiht","D) put up whith"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Put up with is correct. Put up with is a phrasal verb meaning to tolerate or endure something unpleasant."},{"questionText":"Which is the CORRECT spelling of the preposition meaning on the other side of?","options":["A) across","B) acros","C) accross","D) acrross"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Across is correct - A-C-R-O-S-S. Across is a preposition meaning on the other side or from one side to the other."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to continue despite difficulty?","options":["A) persevere","B) persevear","C") perseveare","D) perservere"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Persevere is correct - P-E-R-S-E-V-E-R-E. To persevere means to continue in a course of action despite difficulty."},{"questionText":"Which is the CORRECT spelling of the preposition meaning in the direction of?","options":["A) towards","B) towords","C") twords","D) towardes"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Towards is correct - T-O-W-A-R-D-S. Towards is a preposition meaning in the direction of something."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to cancel?","options":["A) call off","B") call of","C) call offe","D) kall off"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Call off is correct. Call off is a phrasal verb meaning to cancel an event or activity."},{"questionText":"Which is the CORRECT spelling of the preposition meaning in spite of?","options":["A) despite","B) dispite","C") despyte","D) despiite"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Despite is correct - D-E-S-P-I-T-E. Despite is a preposition meaning in spite of or notwithstanding."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to postpone?","options":["A) put off","B") putt off","C) put of","D) put offe"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Put off is correct. Put off is a phrasal verb meaning to postpone or delay."},{"questionText":"Which is the CORRECT spelling of the preposition meaning between two extremes?","options":["A) between","B) betwean","C") betweeen","D) betwen"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Between is correct - B-E-T-W-E-E-N. Between is a preposition indicating a position or relationship involving two things."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to discover?","options":["A) find out","B") finde out","C) fynd out","D) fiend out"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Find out is correct. Find out is a phrasal verb meaning to discover information."},{"questionText":"Which is the CORRECT spelling of the preposition meaning at a lower position?","options":["A) beneath","B) beneth","C") beneathe","D) beneeth"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Beneath is correct - B-E-N-E-A-T-H. Beneath is a preposition meaning in a lower position than."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to accept or handle?","options":["A) deal with","B") deil with","C) deale with","D) deel with"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Deal with is correct. Deal with is a phrasal verb meaning to handle or take action on a matter."},{"questionText":"Which is the CORRECT spelling of the preposition meaning with the purpose of?","options":["A) regarding","B") regardding","C) regardng","D) regairding"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Regarding is correct - R-E-G-A-R-D-I-N-G. Regarding is a preposition meaning with reference to a topic."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to depend on?","options":["A) rely on","B") relie on","C) realy on","D) relly on"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Rely on is correct. Rely on is a phrasal verb meaning to depend or count on someone or something."},{"questionText":"Which is the CORRECT spelling of the preposition meaning alongside?","options":["A) beside","B) besside","C") besyde","D) besiide"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Beside is correct - B-E-S-I-D-E. Beside is a preposition meaning at the side of. Do not confuse with besides meaning in addition to."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to surrender?","options":["A) give in","B") give inn","C) gyve in","D) giv in"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Give in is correct. Give in is a phrasal verb meaning to yield or admit defeat."},{"questionText":"Which is the CORRECT spelling of the preposition meaning prior to?","options":["A) prior to","B") priar to","C) pryor to","D) priort to"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Prior to is correct. Prior to is a prepositional phrase meaning before a particular time."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to refuse?","options":["A) turn down","B") turnn down","C) tern down","D) turn downe"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Turn down is correct. Turn down is a phrasal verb meaning to reject or refuse an offer."},{"questionText":"Which is the CORRECT spelling of the preposition meaning through the middle of?","options":["A) throughout","B) througout","C") throughouut","D) threwout"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Throughout is correct - T-H-R-O-U-G-H-O-U-T. Throughout means in every part of or during an entire time."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to become known?","options":["A) come out","B") coome out","C) comm out","D) come owt"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Come out is correct. Come out is a phrasal verb meaning to become publicly known or available."},{"questionText":"Which is the CORRECT spelling of the preposition meaning at the time of?","options":["A) during","B") durring","C) durnig","D) durrig"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"During is correct - D-U-R-I-N-G. During is a preposition meaning at some point in the course of a period."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to start enthusiastically?","options":["A) embark on","B") embarrk on","C) emmbark on","D) emmbark on"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Embark on is correct. Embark on is a phrasal verb meaning to begin a new project or journey."},{"questionText":"Which is the CORRECT spelling of the preposition meaning in the direction away from?","options":["A) from","B") forme","C) frome","D) ffrom"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"From is correct - F-R-O-M. From is a preposition indicating the starting point or source of something."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to grow into an adult?","options":["A) grow up","B") growe up","C) groe up","D) grow uup"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Grow up is correct. Grow up is a phrasal verb meaning to mature into an adult."},{"questionText":"Which is the CORRECT spelling of the preposition meaning following in order?","options":["A) subsequent","B") subsequant","C) subsequint","D) subsequint"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Subsequent is correct - S-U-B-S-E-Q-U-E-N-T. Subsequent means coming after or following in order."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to remove completely?","options":["A) wipe out","B") wipe owt","C) wype out","D) wiipe out"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Wipe out is correct. Wipe out is a phrasal verb meaning to completely destroy or eliminate."},{"questionText":"Which is the CORRECT spelling of the preposition meaning at a position higher than?","options":["A) above","B") abovve","C) abbove","D) abouve"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Above is correct - A-B-O-V-E. Above is a preposition meaning at a higher level or position."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to tolerate?","options":["A) stand for","B") stande for","C) stend for","D) stand fore"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Stand for is correct. Stand for is a phrasal verb meaning to represent or to tolerate."},{"questionText":"Which is the CORRECT spelling of the preposition meaning outside the boundary of?","options":["A) beyond","B") beyonde","C) beyound","D) biond"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Beyond is correct - B-E-Y-O-N-D. Beyond is a preposition meaning on the far side of or further than."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to confront directly?","options":["A) stand up to","B") stannd up to","C) stand upto","D) stand upe to"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Stand up to is correct. Stand up to is a phrasal verb meaning to confront or challenge someone."},{"questionText":"Which is the CORRECT spelling of the preposition meaning as a result of?","options":["A) owing to","B") oweing to","C) owing too","D) owin to"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Owing to is correct. Owing to is a prepositional phrase meaning because of or as a result of."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to continue despite obstacles?","options":["A) forge ahead","B") forje ahead","C) forge aheed","D) forg ahead"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Forge ahead is correct. Forge ahead is a phrasal verb meaning to continue making progress."},{"questionText":"Which is the CORRECT spelling of the preposition meaning encircling something?","options":["A) surrounding","B") suurrounding","C) surounding","D) surroundding"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Surrounding is correct - S-U-R-R-O-U-N-D-I-N-G. Double R. Surrounding means encircling or encompassing."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to make an effort?","options":["A) strive for","B") stryve for","C) strive fore","D) strife for"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Strive for is correct. Strive for is a phrasal verb meaning to make great efforts to achieve something."},{"questionText":"Which is the CORRECT spelling of the preposition meaning far in front of?","options":["A) ahead of","B") ahed of","C) aheed of","D) ahaid of"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Ahead of is correct. Ahead of is a prepositional phrase meaning in advance of or further forward than."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to make fun of?","options":["A) ridicule","B") riddicule","C) ridicoul","D) ridicule"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Ridicule is correct - R-I-D-I-C-U-L-E. To ridicule means to mock or make fun of someone."},{"questionText":"Which is the CORRECT spelling of the preposition meaning at the rear of?","options":["A) behind","B") behinde","C) behinnd","D) behond"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Behind is correct - B-E-H-I-N-D. Behind is a preposition meaning at or toward the rear of."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to reveal a secret?","options":["A) give away","B") gyve away","C) give awa","D) give awai"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Give away is correct. Give away is a phrasal verb meaning to reveal something that was supposed to be kept secret."},{"questionText":"Which is the CORRECT spelling of the preposition meaning compared to?","options":["A) relative to","B") relattive to","C) relatife to","D) relatve to"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Relative to is correct. Relative to is a prepositional phrase meaning in comparison with something."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to start a new project?","options":["A) set up","B") sett up","C) set uup","D) sett up"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Set up is correct. Set up is a phrasal verb meaning to establish or organize something."},{"questionText":"Which is the CORRECT spelling of the preposition meaning because of?","options":["A) due to","B") dew to","C) du to","D) doo to"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Due to is correct. Due to is a prepositional phrase meaning caused by or because of."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to resist authority?","options":["A) stand against","B") stand agaynst","C) stand agannst","D) stend against"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Stand against is correct. Stand against is a phrasal verb meaning to resist or oppose someone or something."},{"questionText":"Which is the CORRECT spelling of the preposition meaning over the top of?","options":["A) over","B") ovre","C) ovver","D) ova"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Over is correct - O-V-E-R. Over is a preposition indicating position above or movement across."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to accumulate?","options":["A) build up","B") bild up","C) buuild up","D) buildd up"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Build up is correct. Build up is a phrasal verb meaning to gradually accumulate or increase."},{"questionText":"Which is the CORRECT spelling of the preposition meaning within the boundary of?","options":["A) within","B") wiithin","C) withn","D) withhin"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Within is correct - W-I-T-H-I-N. Within is a preposition meaning inside the boundary of something."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to succeed against difficulty?","options":["A) overcome","B") overcomme","C) overrcome","D) ovvercome"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Overcome is correct - O-V-E-R-C-O-M-E. Overcome is a phrasal verb meaning to succeed in dealing with a problem."},{"questionText":"Which is the CORRECT spelling of the preposition meaning at a time before?","options":["A) prior","B") priior","C) pryer","D) prioor"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Prior is correct - P-R-I-O-R. Prior as a preposition means earlier in time or order."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to remove or edit?","options":["A) cut out","B") cutt out","C) cuut out","D) ccut out"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Cut out is correct. Cut out is a phrasal verb meaning to remove by cutting or to stop doing something."},{"questionText":"Which is the CORRECT spelling of the preposition meaning concerning?","options":["A) regarding","B") regardding","C) regardinge","D) reguarding"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Regarding is correct - R-E-G-A-R-D-I-N-G. Regarding is a preposition meaning concerning or with reference to."},{"questionText":"Which is the CORRECT spelling of the phrasal verb meaning to present an idea?","options":["A) put forward","B") putt forward","C) put fowward","D) put forwardd"],"correctAnswer":"A","topic":"Prepositions and Phrasal Verbs","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Put forward is correct. Put forward is a phrasal verb meaning to propose or suggest an idea for consideration."}]