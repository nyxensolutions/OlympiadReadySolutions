[{"questionText":"Which is the CORRECT spelling?","options":["A) Ambiguous","B) Ambigous","C) Ambiguious","D) Ambigoues"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Ambiguous is correct - A-M-B-I-G-U-O-U-S. It means open to more than one interpretation."},{"questionText":"Which is the CORRECT spelling?","options":["A) Heirarchy","B) Hierarchy","C) Hierachy","D) Hierarcy"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Hierarchy is correct - H-I-E-R-A-R-C-H-Y. It means a system of ranking."},{"questionText":"Which is the CORRECT spelling?","options":["A) Lieuenant","B) Leutenant","C) Lieutenant","D) Luietenant"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Lieutenant is correct - L-I-E-U-T-E-N-A-N-T. It is a military rank below captain."},{"questionText":"Which is the CORRECT spelling?","options":["A) Mediocre","B) Mediocur","C) Mediocur","D) Mediokre"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Mediocre is correct - M-E-D-I-O-C-R-E. It means of moderate or low quality."},{"questionText":"Which is the CORRECT spelling?","options":["A) Neccessary","B) Necessary","C) Necesary","D) Neccesary"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Necessary is correct - N-E-C-E-S-S-A-R-Y. Remember: one C two S."},{"questionText":"Which is the CORRECT spelling?","options":["A) Occurence","B) Occurance","C) Occurrence","D) Occurrance"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Occurrence is correct - O-C-C-U-R-R-E-N-C-E. Double C and double R."},{"questionText":"Which is the CORRECT spelling?","options":["A) Perseverence","B) Perserverance","C) Perseverance","D) Persevearance"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Perseverance is correct - P-E-R-S-E-V-E-R-A-N-C-E. It means continued effort despite difficulty."},{"questionText":"Which is the CORRECT spelling?","options":["A) Questionnaire","B) Questionairre","C) Questionnairre","D) Questionaire"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Questionnaire is correct - Q-U-E-S-T-I-O-N-N-A-I-R-E. Double N before AIRE."},{"questionText":"Which is the CORRECT spelling?","options":["A) Rythm","B) Rythym","C) Rhythm","D) Rhythem"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Rhythm is correct - R-H-Y-T-H-M. It has no vowel and both H letters are important."},{"questionText":"Which is the CORRECT spelling?","options":["A) Sacrilegious","B) Sacreligious","C) Sacrilegeous","D) Sacreligeous"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Sacrilegious is correct - S-A-C-R-I-L-E-G-I-O-U-S. It means treating sacred things with disrespect. Note it contains SACRI not SACRE."},{"questionText":"Which is the CORRECT spelling?","options":["A) Temperamental","B) Tempermental","C) Temperamantal","D) Tempramental"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Temperamental is correct - T-E-M-P-E-R-A-M-E-N-T-A-L. It means liable to unreasonable changes of mood."},{"questionText":"Which is the CORRECT spelling?","options":["A) Unintelligable","B) Unintelligible","C) Unintellegible","D) Unintelligeable"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Unintelligible is correct - U-N-I-N-T-E-L-L-I-G-I-B-L-E. It means impossible to understand."},{"questionText":"Which is the CORRECT spelling?","options":["A) Vaccum","B) Vacuum","C) Vaccuum","D) Vacum"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Vacuum is correct - V-A-C-U-U-M. Double U is a distinctive feature of this word."},{"questionText":"Which is the CORRECT spelling?","options":["A) Weirldy","B) Wierdly","C) Weirdly","D) Wierdley"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Weirdly is correct. Weird is W-E-I-R-D. The EI combination breaks the i before e except after c rule."},{"questionText":"Which is the CORRECT spelling?","options":["A) Xenophobia","B) Xenephobia","C) Zeenophobia","D) Xenophobia"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Xenophobia is correct - X-E-N-O-P-H-O-B-I-A. It means a strong dislike of people from other countries."},{"questionText":"Which is the CORRECT spelling?","options":["A) Yeilding","B) Yielding","C) Yeilding","D) Yeelding"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Yielding is correct - Y-I-E-L-D-I-N-G. It follows the i before e rule. Yield means to give way."},{"questionText":"Which is the CORRECT spelling?","options":["A) Zealotry","B) Zealotrey","C) Zeelotry","D) Zealatry"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Zealotry is correct - Z-E-A-L-O-T-R-Y. It means excessive intolerance of opposing views."},{"questionText":"Which is the CORRECT spelling?","options":["A) Abbreviaton","B) Abbreviaton","C) Abbreviation","D) Abreviation"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Abbreviation is correct - A-B-B-R-E-V-I-A-T-I-O-N. Double B followed by REVIATION."},{"questionText":"Which is the CORRECT spelling?","options":["A) Buoyancy","B) Boyancy","C) Buoancy","D) Buoyence"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Buoyancy is correct - B-U-O-Y-A-N-C-Y. It means the ability to float."},{"questionText":"Which is the CORRECT spelling?","options":["A) Caricature","B) Caricature","C) Caricuture","D) Caricutter"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Caricature is correct - C-A-R-I-C-A-T-U-R-E. It means an exaggerated drawing or representation."},{"questionText":"Which is the CORRECT spelling?","options":["A) Discreet","B) Discreete","C) Discret","D) Diskrete"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Discreet is correct - D-I-S-C-R-E-E-T. It means careful not to attract attention. Discrete (separate) is a different word."},{"questionText":"Which is the CORRECT spelling?","options":["A) Ebulliant","B) Ebullient","C) Ebulient","D) Ebullent"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Ebullient is correct - E-B-U-L-L-I-E-N-T. Double L and the IE combination. It means cheerfully enthusiastic."},{"questionText":"Which is the CORRECT spelling?","options":["A) Fahrenheit","B) Farenheit","C) Fahrenhiet","D) Farenheit"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Fahrenheit is correct - F-A-H-R-E-N-H-E-I-T. Named after physicist Daniel Fahrenheit. Note FAHR at the start."},{"questionText":"Which is the CORRECT spelling?","options":["A) Grotesk","B) Grotesque","C) Groteque","D) Grotesq"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Grotesque is correct - G-R-O-T-E-S-Q-U-E. It means comically or repulsively ugly. Note the ESQUE ending."},{"questionText":"Which is the CORRECT spelling?","options":["A) Hypocricy","B) Hypocrisy","C) Hypocracy","D) Hypocrissy"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Hypocrisy is correct - H-Y-P-O-C-R-I-S-Y. It means the practice of pretending to have beliefs one does not actually hold."},{"questionText":"Which is the CORRECT spelling?","options":["A) Idiosyncrasy","B) Idiosyncrasy","C) Idiosyncracy","D) Idioysncrasy"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Idiosyncrasy is correct - I-D-I-O-S-Y-N-C-R-A-S-Y. It means a characteristic peculiar to an individual."},{"questionText":"Which is the CORRECT spelling?","options":["A) Juxtapose","B) Juxtapoze","C) Juxstapose","D) Juxtaposse"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Juxtapose is correct - J-U-X-T-A-P-O-S-E. It means to place side by side for comparison."},{"questionText":"Which is the CORRECT spelling?","options":["A) Kaleidescope","B) Kaleidoscope","C) Kaliedoscope","D) Kaleodiscope"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Kaleidoscope is correct - K-A-L-E-I-D-O-S-C-O-P-E. It is a toy containing mirrors and colored glass."},{"questionText":"Which is the CORRECT spelling?","options":["A) Liquefy","B) Liquify","C) Liqefy","D) Liqufy"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Liquefy is correct - L-I-Q-U-E-F-Y. Note the E before FY. Liquify is a common misspelling."},{"questionText":"Which is the CORRECT spelling?","options":["A) Millenium","B) Milenium","C) Millennium","D) Milennium"],"correctAnswer":"C","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Millennium is correct - M-I-L-L-E-N-N-I-U-M. Double L and double N. It means a period of 1000 years."},{"questionText":"Which is the CORRECT spelling?","options":["A) Nauseous","B) Nausious","C) Nauseous","D) Nausous"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Nauseous is correct - N-A-U-S-E-O-U-S. The AU followed by SEOUS is the pattern to remember."},{"questionText":"Which is the CORRECT spelling?","options":["A) Oscillate","B) Oscilate","C) Ocillate","D) Oscilllate"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Oscillate is correct - O-S-C-I-L-L-A-T-E. Double L before ATE. It means to move back and forth."},{"questionText":"Which is the CORRECT spelling?","options":["A) Paraphernelia","B) Paraphernalia","C) Parafirnalia","D) Paraphanalia"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Paraphernalia is correct - P-A-R-A-P-H-E-R-N-A-L-I-A. It means miscellaneous articles or equipment."},{"questionText":"Which is the CORRECT spelling?","options":["A) Reconnaissance","B) Reconaissance","C) Reconissiance","D) Reconnaissence"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Reconnaissance is correct - R-E-C-O-N-N-A-I-S-S-A-N-C-E. Double N and double S. It means military observation of a region."},{"questionText":"Which is the CORRECT spelling?","options":["A) Seperate","B) Separate","C) Seperite","D) Separete"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Separate is correct - S-E-P-A-R-A-T-E. The middle part is PAR not PER. There is a rat in separate."},{"questionText":"Which is the CORRECT spelling?","options":["A) Turrmoil","B) Turmoil","C) Turmmoil","D) Turrmol"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Turmoil is correct - T-U-R-M-O-I-L. It means a state of great disturbance or confusion."},{"questionText":"Which is the CORRECT spelling?","options":["A) Ubiquitous","B) Ubiqitous","C) Ubiquituous","D) Ubiiquitous"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Ubiquitous is correct - U-B-I-Q-U-I-T-O-U-S. It means present everywhere simultaneously."},{"questionText":"Which is the CORRECT spelling?","options":["A) Vengeance","B) Vengance","C) Vengence","D) Vengiance"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Vengeance is correct - V-E-N-G-E-A-N-C-E. Note VENGE plus ANCE. It means punishment inflicted as revenge."},{"questionText":"Which is the CORRECT spelling?","options":["A) Whimsical","B) Whimsicle","C) Wimsical","D) Whimmsical"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Whimsical is correct - W-H-I-M-S-I-C-A-L. It means playfully quaint or fanciful."},{"questionText":"Which is the CORRECT spelling?","options":["A) Exhilerate","B) Exhilarate","C) Exhillarate","D) Exhilerete"],"correctAnswer":"B","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Exhilarate is correct - E-X-H-I-L-A-R-A-T-E. Note HILAR in the middle. It means to make someone feel very happy."},{"questionText":"Which is the CORRECT spelling?","options":["A) Fluorescent","B) Flourescent","C) Flurescent","D) Flouresent"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Fluorescent is correct - F-L-U-O-R-E-S-C-E-N-T. From fluorine. It means emitting light when exposed to radiation."},{"questionText":"Which is the CORRECT spelling?","options":["A) Genealogy","B) Geneology","C) Geneaology","D) Genealoogy"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Genealogy is correct - G-E-N-E-A-L-O-G-Y. Note GENE then ALOGY. It is the study of family histories."},{"questionText":"Which is the CORRECT spelling?","options":["A) Harassment","B) Harrassment","C) Harrasment","D) Harasment"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Harassment is correct - H-A-R-A-S-S-M-E-N-T. One R and double S. It means aggressive pressure or intimidation."},{"questionText":"Which is the CORRECT spelling?","options":["A) Impeccable","B) Impecable","C) Impeccible","D) Impeckable"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Impeccable is correct - I-M-P-E-C-C-A-B-L-E. Double C before ABLE. It means in accordance with the highest standards."},{"questionText":"Which is the CORRECT spelling?","options":["A) Jeopardize","B) Jeopordize","C) Jeopardise","D) Both A and C"],"correctAnswer":"D","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Both Jeopardize (American) and Jeopardise (British) are correct spellings. The word means to put at risk of harm."},{"questionText":"Which is the CORRECT spelling?","options":["A) Knowledgeable","B) Knowledgable","C) Knowlegeable","D) Knowledgible"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Advanced","explanation":"Knowledgeable is correct - K-N-O-W-L-E-D-G-E-A-B-L-E. The E is retained before ABLE. It means having much knowledge."},{"questionText":"Which is the CORRECT spelling?","options":["A) Labyrinthine","B) Labirinthine","C) Labrynthine","D) Labyrinthin"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Labyrinthine is correct - L-A-B-Y-R-I-N-T-H-I-N-E. It means relating to or resembling a labyrinth - intricate and complex."},{"questionText":"Which is the CORRECT spelling?","options":["A) Magistrate","B) Magastrate","C) Magistrait","D) Magistrit"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Magistrate is correct - M-A-G-I-S-T-R-A-T-E. It is a civil officer or judge."},{"questionText":"Which is the CORRECT spelling?","options":["A) Narcissism","B) Narcisism","C) Narcicissm","D) Narcissim"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Olympiad","explanation":"Narcissism is correct - N-A-R-C-I-S-S-I-S-M. Double S is key. It means excessive interest in oneself."},{"questionText":"Which is the CORRECT spelling?","options":["A) Oblivious","B) Oblievous","C) Obliveus","D) Oblivous"],"correctAnswer":"A","topic":"Correct Spelling Identification","subTopic":"correct-spelling","difficulty":"Foundation","explanation":"Oblivious is correct - O-B-L-I-V-I-O-U-S. It means not aware of what is happening around oneself."}]